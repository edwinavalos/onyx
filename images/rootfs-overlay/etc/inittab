::sysinit:/sbin/openrc sysinit
::sysinit:/sbin/openrc boot
# "once", not "wait": the console login must not queue behind the default
# runlevel (DHCP takes ~2 s). Everything the login needs is in boot.
::once:/sbin/openrc default

# Serial console (Vz virtio console): auto-login the work user; its profile
# hands off to the Onyx session if the host has requested one.
hvc0::respawn:/sbin/agetty -a dev -L hvc0 115200 xterm-256color

::shutdown:/sbin/openrc shutdown
::ctrlaltdel:/sbin/reboot
