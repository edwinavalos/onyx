#!/bin/sh
# Claude Code entry point: every way of starting it (console session, ossh,
# a shell in the VM) goes through here, so the first-run prompts are
# answered before the real CLI runs. build-alpine.sh moves the npm launcher
# this replaces to claude-cli.
"$(dirname "$0")/onyx-trust"
exec "${ONYX_CLAUDE_CLI:-$(dirname "$0")/claude-cli}" "$@"
